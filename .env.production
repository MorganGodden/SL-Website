# Production build settings, used by `npm run build` and `npm run deploy`.
# Vite reads this after .env, so these win. Public values only: all of this
# ends up in the bundle.
VITE_PLOTS_API_URL=https://sl.bfrd.uk
VITE_PLOTS_POLL_MS=3000
VITE_SEASON_PREVIEW=false
# The address players join, shown on the countdown card with a copy button.
# Blank leaves the line out. Keep it here: without it, the dev address in .env
# would ship instead.
VITE_SERVER_IP=amp.svr0.co.uk:25574
