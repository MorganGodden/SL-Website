# Copy to `.env`. `.env` is gitignored; this file documents what it must contain.

# The sl-plugin snapshot endpoint. It binds to loopback on the machine running
# the Minecraft server. If the browser is on Windows and the server is in WSL and
# `127.0.0.1` does not reach it, use the WSL interface address instead.
VITE_PLOTS_API_URL='http://127.0.0.1:8787'

# Only if the plugin is configured with a shared secret. Leave unset locally.
# VITE_PLOTS_SECRET=''

# Change index poll interval, milliseconds.
VITE_PLOTS_POLL_MS=3000

# Lets the dev server past Season 1's pre-season countdown. Put it in
# .env.development.local, which only `npm run dev` reads. Not .env or
# .env.local: production builds read those too. .env.production sets it false.
# VITE_SEASON_PREVIEW=true

VITE_SERVER_IP='172.29.253.41:25565'
